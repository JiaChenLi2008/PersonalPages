  "scholarly-igem.title": {
    "text": "iGEM 项目：帕金森病的微生物疗法",
    "src": "content-brief.md#段[29]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.no": {
    "text": "01.1",
    "chrome": true,
    "lang": "en"
  },
  "scholarly-igem.sub1": {
    "text": "实验室贡献",
    "src": "content-brief.md#段[33]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.para1": {
    "text": "在 iGEM 里，我负责湿实验这一侧：做实验、产出真实数据，并协助协调团队的实验台工作流程。我们的项目聚焦于改造微生物来生产左旋多巴——帕金森病的一线治疗药物——目标是找到一种更可持续的药物生产方式。我在意细节：可重复性、干净的数据，以及确保我们的结果对团队其他成员确实有意义。",
    "src": "content-brief.md#段[34]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.sub2": {
    "text": "巴黎会议",
    "src": "content-brief.md#段[37]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.para2": {
    "text": "在巴黎，我在 iGEM 总决赛上带领一个三人小组。我主持了我们的研讨会、看管展位，会议期间大部分时间都在把我们的科学用平实的语言讲给评委、研究人员和路过的学生听。向随机路过的人解释微生物生物合成？那才是真正的挑战——说实话，也是最好玩的部分。",
    "src": "content-brief.md#段[39]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.cta.zh": {
    "text": "欢迎跳转我们的项目网站，点击此处链接详细情况",
    "src": "content-brief.md#段[41]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.cta.en": {
    "text": "欢迎访问我们的项目网站，点击此处了解更多详情。",
    "src": "content-brief.md#段[41]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.cta.url": {
    "text": "https://2025.igem.wiki/subcat-shanghai/",
    "src": "content-brief.md#段[41]",
    "lang": "en"
  },

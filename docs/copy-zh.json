    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar4.item2": {
    "text": "兼容工业生物反应器",
    "src": "docx-1021-brief.md#段[29]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar4.item3": {
    "text": "易于适配多种治疗菌株",
    "src": "docx-1021-brief.md#段[30]",
    "lang": "zh-Hans"
  },

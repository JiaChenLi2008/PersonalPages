  "scholarly-igem.result.title": {
    "text": "项目想要证明什么",
    "src": "docx-1021-brief.md#段[13]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.result.body": {
    "text": "iGEM 想证明的事情很具体：微生物可以生产左旋多巴——帕金森病的一线药物——而不必依赖现行路线那套浪费严重的化学工艺。我负责湿实验一侧：跑实验、产出团队可以据以推进的真实数据，并让我们的实验台流程保持可复现。我们带到总决赛现场的不是承诺，而是一份记录：干净的数字、诚实的边界，以及一条能向任何在展位前停下的人讲清楚的生物合成路线。",
    "src": "docx-1021-brief.md#段[14]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar1.title": {
    "text": "环境友好型生产",
    "src": "docx-1021-brief.md#段[15]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar1.item1": {
    "text": "减少有毒化学品",
    "src": "docx-1021-brief.md#段[16]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar1.item2": {
    "text": "降低能耗",
    "src": "docx-1021-brief.md#段[17]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar1.item3": {
    "text": "减少废弃物产生",
    "src": "docx-1021-brief.md#段[18]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar2.title": {
    "text": "高效合成",
    "src": "docx-1021-brief.md#段[19]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar2.item1": {
    "text": "提高产量",
    "src": "docx-1021-brief.md#段[20]",
    "lang": "zh-Hans"
  },
  "scholarly-igem.pillar2.item2": {
    "text": "缩短生产周期",

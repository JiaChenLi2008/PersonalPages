  "scholarly-igem.title": {
    "text": "iGEM Project; probotic therapy for Parkinson’s treatment",
    "src": "content-brief.md#段[29]",
    "lang": "en"
  },
  "scholarly-igem.no": {
    "text": "01.1",
    "chrome": true,
    "lang": "en"
  },
  "scholarly-igem.sub1": {
    "text": "Lab contribution",
    "src": "content-brief.md#段[33]",
    "lang": "en"
  },
  "scholarly-igem.para1": {
    "text": "In iGEM, I worked on the wet lab side—running experiments, generating real data, and helping coordinate the team's bench workflow. Our project focused on engineering microbes to produce levodopa, a first-line treatment for Parkinson's disease, aiming for a more sustainable way to make the drug. I cared about the details: reproducibility, clean data, and making sure our results actually meant something for the rest of the team.",
    "src": "content-brief.md#段[34]",
    "lang": "en"
  },
  "scholarly-igem.sub2": {
    "text": "Paris Conference",
    "src": "content-brief.md#段[37]",
    "lang": "en"
  },
  "scholarly-igem.para2": {
    "text": "In Paris, I led a three-person team at the iGEM Grand Jamboree. I ran our seminar, managed the booth, and spent most of the conference translating our science into plain language for judges, researchers, and students passing by. Explaining microbial biosynthesis to a random audience? That was the real challenge—and honestly, the most fun part.",
    "src": "content-brief.md#段[39]",
    "lang": "en"
  },
  "scholarly-igem.cta.zh": {
    "text": "Welcome to visit our project website. Click here for more details.",
    "src": "content-brief.md#段[41]",
    "lang": "en"
  },
  "scholarly-igem.cta.en": {
    "text": "Welcome to visit our project website. Click here for more details.",
    "src": "content-brief.md#段[41]",
    "lang": "en"
  },

  "sport.lead": {
    "text": "For me, sports were never just about winning. It’s about pushing my physical limits and, more importantly, the joy of growing alongside my teammates. I love how movement creates a shared rhythm—building genuine connections and bonds that go far beyond the game itself.",
    "src": "docx-2026-10-brief.md#段[26]",
    "lang": "en"
  },

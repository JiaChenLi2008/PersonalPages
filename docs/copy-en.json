  "scholarly-jhu.q1": {
    "text": "Hello, I look like a three, guess what am I?",
    "src": "content-brief.md#段[48]",
    "lang": "en"
  },
  "scholarly-jhu.a1": {
    "text": "Hippocampus isolated from a sheep brain after dissection",
    "src": "content-brief.md#段[48]",
    "lang": "en"
  },
  "scholarly-jhu.q2": {
    "text": "Hello, I may look like a bone-in lamp leg huh? But I am not. Guess what am I?",
    "src": "content-brief.md#段[51]",
    "lang": "en"
  },
  "scholarly-jhu.a2": {
    "text": "The heart and lungs of a cow",
    "src": "content-brief.md#段[52]",
    "lang": "en"
  },
  "scholarly-jhu.q3": {
    "text": "Hello, do I look like your average orange juice on the shelf?I dare you to zoom in and look at my label up close, you will see I am........",
    "src": "content-brief.md#段[52]",
    "lang": "en"
  },
  "scholarly-jhu.a3": {
    "text": "A bottle of artificial urine, I bet you just lost appetite in me huh? haha!",
    "src": "content-brief.md#段[53]",
    "lang": "en"
  },

  "scholarly-immuno.title": {
    "text": "Immunotherapy Studies",
    "src": "layout-brief.md#段[23]",
    "lang": "en"
  },
  "scholarly-immuno.no": {
    "text": "01.3",
    "chrome": true,
    "lang": "en"
  },
  "scholarly-immuno.q1.no": {
    "text": "1",
    "src": "content-brief.md#段[60]",
    "lang": "en"
  },
  "scholarly-immuno.q1": {
    "text": "We always say “boost immunity”—but do you actually know how the immune system works?",
    "src": "content-brief.md#段[60]",
    "lang": "en"
  },
  "scholarly-immuno.a1": {
    "text": "It actually has built-in “brakes” to keep itself from going out of control. So here's the question: do you know what happens when immunity loses control?",
    "src": "content-brief.md#段[61]",
    "lang": "en"
  },
  "scholarly-immuno.q2.no": {
    "text": "2",
    "src": "content-brief.md#段[63]",
    "lang": "en"
  },
  "scholarly-immuno.q2": {
    "text": "The immune system can kill cancer. So why does cancer still spread?",
    "src": "content-brief.md#段[63]",
    "lang": "en"
  },
  "scholarly-immuno.a2": {
    "text": "The answer might surprise you: tumors don't fight head-on. They quietly “press” the immune system's brakes.",
    "src": "content-brief.md#段[64]",
    "lang": "en"
  },
  "scholarly-immuno.q3.no": {
    "text": "3",
    "src": "content-brief.md#段[66]",
    "lang": "en"
  },
  "scholarly-immuno.q3": {
    "text": "If the immune system is so powerful, why do we still need immunotherapy?",
    "src": "content-brief.md#段[66]",
    "lang": "en"
  },
  "scholarly-immuno.a3": {
    "text": "Because our understanding of the immune system may be far less than we think. How it balances itself, how it loses control, how tumors exploit it—these are questions science is still working to answer.",
    "src": "content-brief.md#段[67]",
    "lang": "en"
  },

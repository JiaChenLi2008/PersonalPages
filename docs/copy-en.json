  "scholarly-igem.result.title": {
    "text": "What the project set out to prove",
    "src": "docx-1021-brief.md#段[13]",
    "lang": "en"
  },
  "scholarly-igem.result.body": {
    "text": "iGEM set out to prove something narrow and useful: that microbes can produce levodopa, a first-line Parkinson’s drug, without the wasteful chemistry the current route depends on. I worked on the wet lab side—running the experiments, generating the real data the team built on, and keeping our bench workflow reproducible. What we carried to the Grand Jamboree was not a promise but a record: clean numbers, honest limits, and a biosynthesis route we could explain to anyone who stopped at the booth.",
    "src": "docx-1021-brief.md#段[14]",
    "lang": "en"
  },
